# OPTIONAL: secure backend service endpoint which receives festival sign-up forms.
# The form clearly reports unavailability until configured, rather than falsely claiming success.
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_API_TOKEN=

# Browser-safe FrontDesk key; register the website origin on this key in FrontDesk.
NEXT_PUBLIC_FRONTDESK_PUBLISHABLE_KEY=
# Server-only key for hosted ticket checkout. Never prefix this with NEXT_PUBLIC_.
FRONTDESK_SECRET_KEY=

# OPTIONAL: links for public launch. Add these to lib/site-config.ts, not here, if they are public URLs.
